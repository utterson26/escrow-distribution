# Mainnet — copy to .env.mainnet (gitignored) and fill in. Keys never go in the repo.
# RPC with Token-2022 getProgramAccounts and archival history (the indexer replays token accounts)
MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE
# Signs deploys, set_platform, migrate_config. Move to a multisig (MULTISIG_UPGRADE_AUTHORITY) after go-live.
UPGRADE_AUTHORITY_KEYPAIR=/secure/path/upgrade-authority.json
# Mainnet program id. NOT the devnet id (its keypair is lost): generate a new keypair, put its pubkey in
# declare_id!() and Anchor.toml, rebuild, and keep the keypair offline after the first deploy.
MAINNET_PROGRAM_ID=5iJybmLoueR89iFLp1abte7s75coVexn7LKkXUQtUGHe   # REPLACE for mainnet; the devnet id is here only so --dry-run passes the declare_id check
# Only set on the very first deploy (the account is created from it); afterwards the pubkey is enough.
PROGRAM_KEYPAIR=/secure/path/mainnet-program.json
# The key that opens rounds, intervenes, pauses launches and proposes fee / cap changes. Not the upgrade key.
PLATFORM_AUTHORITY_PUBKEY=REPLACE
# Receives the platform's share of pump's creator fee (written into each coin's sharing config at setup)
PLATFORM_FEE_WALLET_PUBKEY=REPLACE
# Low-value hot key the crank sends with; fund it for fees only (~0.5 SOL), separate from all of the above
CRANK_KEYPAIR=/secure/path/crank.json
# Optional: Squads (or similar) vault that takes over as upgrade authority at the end of the deploy script
MULTISIG_UPGRADE_AUTHORITY=
# Priority fee for deploy transactions, micro-lamports per CU
PRIORITY_FEE_MICROLAMPORTS=10000
